---
import { type Meta, type Schema } from "@components/core/MySEO.astro";

import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import Section from "~/components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";

import Banner from "~/components/widgets/Banner.astro";

type Props = {
  pageTitle?: string;
  pageDescription?: string;
  meta: Meta;
  schema?: Schema;
};

const { pageTitle, pageDescription, meta, schema } = Astro.props;
---

<BaseLayout meta={meta} schema={schema}>
  <Banner />
  <div class="w-full flex justify-center">
    <div
      class="flex flex-col min-h-screen justify-between w-full shadow-primary"
    >
      <Navbar />
      <main class="w-full block">
        {
          pageTitle && (
            <Section heroSection>
              <div class="flex flex-col gap-8 animate-reveal">
                <Heading tag="h1" look="h0">{pageTitle}</Heading>
                {pageDescription && (
                  <p class="text-xl md:text-2xl text-base-content/60 font-light leading-relaxed max-w-xl">
                    {pageDescription}
                  </p>
                )}
                <slot name="header" />
              </div>
            </Section>
          )
        }
        <slot />
      </main>
      <Footer />
    </div>
  </div>
</BaseLayout>
