---
import type { CollectionEntry } from "astro:content";

import PageLayout from "@layouts/PageLayout.astro";
import { type Meta, type Schema } from "@components/core/MySEO.astro";

import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import PortfolioCard from "@components/collection/PortfolioCard.astro";
import Button from "@components/ui/Button.astro";
import Grid from "~/components/layout/Grid.astro";
import Categories from "~/components/collection/Categories.astro";
import CTA from "~/components/sections/CTA.astro";
import Compliments from "@components/sections/Compliments.astro";
import MyImage from "@components/ui/MyImage.astro";
import archiveImage from "@assets/images/pages/solution-map-v1.png";

export interface Props {
  items: CollectionEntry<"portfolio">[];
  categories?: string[];
  pageTitle?: string;
  pageDescription?: string;
  meta: Meta;
  schema?: Schema;
}

const { items, categories, pageTitle, pageDescription, meta, schema } =
  Astro.props;
---

<PageLayout meta={meta} schema={schema}>
  <Section padding="none" class="archive-hero pt-16 pb-10 md:pt-20 md:pb-12 lg:pt-24 lg:pb-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_.72fr] lg:items-center lg:gap-16">
      <div class="flex flex-col gap-8">
      {pageTitle && <Heading tag="h1" look="h0">{pageTitle}</Heading>}
      {
        pageDescription && (
          <p class="text-xl md:text-2xl text-base-content/60 font-light leading-relaxed max-w-xl">
            {pageDescription}
          </p>
        )
      }
      {
        categories && categories.length > 0 && (
          <div class="flex flex-wrap gap-4">
            <Categories
              baseSlug="/portfolio/kategoria/"
              categories={categories}
            />
          </div>
        )
      }
      </div>
      <div class="archive-hero-art hero-illustration" aria-hidden="true"><MyImage img={archiveImage} alt="" size="h-full w-full" layout="object-contain" aspect="aspect-square" rounded="rounded-none" shadow="" class="h-full w-full p-3 md:p-5" /></div>
    </div>
  </Section>

  <Section padding="none" class="pb-16 md:pb-20 lg:pb-24">
    {
      items.length === 0 ? (
        <div class="flex bg-base-300 py-16 rounded-box shadow flex-col gap-4 items-center justify-center w-auto">
          <p class="text-h5">
            Niestety, ale nie ma jeszcze realizacji na stronie
          </p>
          <Button link="/">Wróć na strony głównej</Button>
        </div>
      ) : (
        <Grid cols={1} gap="large">
          {items.map((item) => (
            <PortfolioCard item={item} headingTag="h2" />
          ))}
        </Grid>
      )
    }
  </Section>

  <Compliments variant="secondary" />

  <CTA
    id="kontakt"
    heading="Masz problem do rozwiązania?"
    paragraph="Opisz go po ludzku. Wspólnie sprawdzimy, czy potrzebna jest strona, narzędzie czy mały test konkretnego rozwiązania."
    button1={{ link: "/kontakt", text: "Napisz do mnie" }}
    variant="primary"
  />
</PageLayout>
