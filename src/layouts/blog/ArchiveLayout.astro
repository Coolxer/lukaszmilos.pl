---
import type { Page } from "astro";
import config from "@data/consts.json";

import { type Meta, type Schema } from "@components/core/MySEO.astro";
import PageLayout from "@layouts/PageLayout.astro";

import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";

import PostCard from "@components/collection/PostCard.astro";
import PagePagination from "@components/collection/PagePagination.astro";
import Categories from "@components/collection/Categories.astro";

export interface Props {
  page: Page;
  categories?: string[];
  pageTitle?: string;
  pageDescription?: string;
  meta: Meta;
  schema?: Schema;
}

const { page, categories, pageTitle, pageDescription, meta, schema } =
  Astro.props;
---

<PageLayout meta={meta} schema={schema}>
  <Section padding="none" class="pt-24 md:pt-36 lg:pt-44 pb-8 md:pb-10">
    <div class="flex flex-col gap-8 animate-reveal">
      {pageTitle && <Heading tag="h1" look="h0">{pageTitle}</Heading>}
      {
        pageDescription && (
          <p class="text-xl md:text-2xl text-base-content/60 font-light leading-relaxed max-w-xl">
            {pageDescription}
          </p>
        )
      }
      {
        categories && categories.length > 0 && (
          <div class="flex flex-wrap gap-4">
            <Categories baseSlug="/blog/kategoria/" categories={categories} />
          </div>
        )
      }
    </div>
  </Section>

  <Section padding="none" class="pb-16 md:pb-20 lg:pb-24">
    {
      page && page.data && page.data.length > 0 ? (
        <div class="my-big-stack">
          <div>
            {page.data.map((post) => (
              <PostCard post={post} headingTag="h2" />
            ))}
          </div>
          <div class="flex items-center justify-center">
            <PagePagination
              baseSlug="/blog/"
              page={page}
              itemsPerPage={config.site.itemsPerPage.blog}
            />
          </div>
        </div>
      ) : (
        <div class="py-16 flex flex-col gap-4 items-center justify-center">
          <p class="text-h5 text-base-content/60">
            Niestety, nie ma jeszcze postów na blogu
          </p>
          <Button link="/">Wróć do strony głównej</Button>
        </div>
      )
    }
  </Section>
</PageLayout>
