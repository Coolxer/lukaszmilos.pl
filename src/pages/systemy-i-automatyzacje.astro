---
import { Icon } from "astro-icon/components";
import { type CollectionEntry, getCollection } from "astro:content";

import PageLayout from "@layouts/PageLayout.astro";
import { type Meta, type Schema } from "@components/core/MySEO.astro";
import { PORTFOLIO_CATEGORIES } from "~/content/schemas";

import HeroImg from "@assets/images/pages/systemy-i-automatyzacje/systemy-i-automatyzacje.svg";

import Section from "@components/layout/Section.astro";
import Grid from "@components/layout/Grid.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import IconList from "@components/ui/IconList.astro";
import MyImage from "@components/ui/MyImage.astro";
import FAQ from "@components/ui/FAQ.astro";

import PortfolioCard from "@components/collection/PortfolioCard.astro";
import ReviewCard from "@components/collection/ReviewCard.astro";
import CTA from "@components/sections/CTA.astro";
import Compliments from "~/components/sections/Compliments.astro";

const meta: Meta = {
  title: "Cyfryzacja i Automatyzacja dla firm",
  description:
    "Pomagam uporządkować procesy i wdrożyć proste narzędzia, by Twoja firma działała sprawniej i bez błędów. Odzyskaj kontrolę i czas na rozwój.",
};

const schema: Schema = {
  "@context": "https://schema.org",
  "@type": "WebService",
  name: "Wdrażanie systemów i automatyzacji dla firm",
  description:
    "Pomagam mikro i małym firmom uporządkować procesy oraz wdrożyć proste narzędzia i automatyzacje, które zwiększają efektywność i redukują błędy. Dzięki temu przedsiębiorcy mogą skupić się na rozwoju biznesu, zamiast tracić czas na ręczną pracę.",
  provider: {
    "@type": "Person",
    name: "Łukasz Miłoś",
  },
  serviceType: "Wdrażanie systemów i automatyzacji dla firm",
  areaServed: "PL",
};

const relatedProjects = (
  await getCollection("portfolio", ({ data }) => {
    return (
      !data.draft &&
      data.category &&
      (data.category === PORTFOLIO_CATEGORIES[1] ||
        data.category === PORTFOLIO_CATEGORIES[2])
    );
  })
).slice(0, 2);

const relatedReviews = (
  await getCollection("reviews", ({ data }) => {
    return (
      !data.draft &&
      data.service &&
      (data.service.includes(PORTFOLIO_CATEGORIES[1]) ||
        data.service.includes(PORTFOLIO_CATEGORIES[2]))
    );
  })
).slice(0, 2);
---

<PageLayout meta={meta}>
  <!-- [SEKCJA HERO] -->
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-3xl">
      <!-- Subtelny tag inżynierski -->
      <div
        class="inline-flex items-center gap-2 px-3 py-1 bg-slate-100 text-slate-600 rounded text-xs font-medium mb-6 uppercase tracking-wider border border-slate-200/60"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-amber-500"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v240H0z" fill="none"></path>
          <path d="M7 10l5 -6l5 6v10a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1z"></path>
          <path d="M7 10l5 4l5 -4" stroke-dasharray="2 2"></path>
        </svg>
        Szczególnie firm technicznych, warsztatów i producentów
      </div>

      <h1
        class="text-4xl md:text-6xl font-bold text-slate-900 leading-[1.1] mb-6"
      >
        Narzędzia cyfrowe i wsparcie IT dla małych firm.
      </h1>

      <p
        class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-2xl mb-10"
      >
        Pomagam uporządkować to, co dzieje się wokół strony, maili, wycen,
        dokumentów i codziennej pracy z danymi w Twojej firmie.. <br /><br />
        Od prostych napraw i porządków technicznych po narzędzia, które <span
          class="text-slate-900 font-medium bg-amber-500/10 px-1.5 py-0.5 rounded"
          >skracają czas pracy i ograniczają liczbę pomyłek</span
        >.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#kontakt"
          class="inline-flex justify-center items-center px-6 py-3.5 bg-slate-900 text-white font-medium rounded hover:bg-slate-800 transition-colors shadow-sm group"
        >
          Skontaktuj się
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 ml-2 text-amber-400 group-hover:translate-x-0.5 transition-transform"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path stroke="none" d="M0 0h24v240H0z" fill="none"></path>
            <path d="M5 12l14 0"></path>
            <path d="M13 18l6 -6"></path>
            <path d="M13 6l6 6"></path>
          </svg>
        </a>
        <a
          href="#w-czym-pomagam"
          class="inline-flex justify-center items-center px-6 py-3.5 bg-white text-slate-700 font-medium rounded border border-slate-200 hover:bg-slate-50 transition-colors"
        >
          Zobacz szczegóły
        </a>
      </div>
    </div>
  </section>

  <!-- [SEKCJA: PROBLEMY / DIAGNOZA] -->
  <section class="bg-white border-y border-slate-200/60 py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          Problemy wielu małych firm technicznych?
        </h2>

        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-6">
          Wiele codziennych problemów w firmie nie wynika z braku drogich
          systemów, ale z chaosu w tych narzędziach, które już posiadasz.
          Pomagam okiełznać technologię na zapleczu biznesu, oszczędzając Twój
          czas i eliminując ryzyko ludzkich pomyłek.
        </p>

        <p class="text-base md:text-lg text-slate-900 font-medium mb-8">
          W wielu małych firmach technicznych wciąż wygląda to podobnie:
        </p>

        <div class="grid md:grid-cols-2 gap-x-8 gap-y-4 mb-12">
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              poczta firmowa lub formularz działa niestabilnie albo wpada do
              spamu,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              nie wiesz lub nie reagujesz wystarczająco szybko na e-maila
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              zapytania przychodzą mailem bez kompletu danych,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              wyceny są liczone ręcznie i zajmują za dużo czasu,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              dokumenty powstają metodą kopiuj-wklej,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              wiele rzeczy niepotrzebnie robisz manualnie
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              nikt nie ma dostępu do hostingu, domeny albo starej strony,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              pliki i dokumentacja są porozrzucane po komputerach, mailach i
              pendrive’ach,
            </p>
          </div>
          <div class="flex gap-4 items-start">
            <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2"></div>
            <p class="text-slate-600 text-sm md:text-base leading-relaxed">
              coś „działa”, ale tylko dopóki się nie zepsuje.
            </p>
          </div>
        </div>

        <div class="p-6 bg-amber-50 border border-amber-200/60 rounded-lg">
          <p class="text-base text-slate-800 leading-relaxed">
            To nie zawsze wymaga dużego systemu albo wdrożenia za dziesiątki
            tysięcy.<br />
            <strong class="font-semibold"
              >Często wystarczy dobrze zdiagnozować problem i wdrożyć proste,
              sensowne rozwiązanie.</strong
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- [SEKCJA: W CZYM POMAGAM W SKRÓCIE] -->
  <section
    id="w-czym-pomagam"
    class="bg-slate-50 border-y border-slate-200/60 py-24 md:py-32"
  >
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          W czym pomagam w telegraficznym skrócie?
        </h2>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-12">
          Obszary, w których najczęściej pomagam klientom:
        </p>

        <div class="space-y-12">
          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200 focus-within:border-amber-500 hover:border-amber-500 transition-colors"
          >
            <span
              class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-2"
              >01 / Precyzja</span
            >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">
              Dedykowane kalkulatory i konfiguratory
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Tworzę narzędzia online (wygodne formularze), które pozwalają
              Twoim klientom precyzyjnie określić parametry zamówienia. Ty
              zamiast chaotycznych maili otrzymujesz gotowy, czysty brief do
              wyceny.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200 focus-within:border-amber-500 hover:border-amber-500 transition-colors"
          >
            <span
              class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-2"
              >02 / Integracja</span
            >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">
              Automatyczny obieg informacji
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Łączę ze sobą różne programy (skrzynkę e-mail, arkusze
              kalkulacyjne, bazy danych), eliminując potrzebę ręcznego
              przepisywania tych samych danych w kilka miejsc.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200 focus-within:border-amber-500 hover:border-amber-500 transition-colors"
          >
            <span
              class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-2"
              >03 / Szablony</span
            >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">
              Generatory dokumentów i plików
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Buduję skrypty automatycznie tworzące powtarzalne dokumenty,
              oferty handlowe, potwierdzenia zamówień czy proste specyfikacje w
              formacie PDF.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200 focus-within:border-amber-500 hover:border-amber-500 transition-colors"
          >
            <span
              class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-2"
              >04 / Baza wiedzy</span
            >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">
              Dokumentacja i instrukcje online
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Przenoszę bazy wiedzy, procedury lub instrukcje obsługi do chmury,
              tak aby były błyskawicznie dostępne z poziomu smartfona dla
              każdego pracownika na stanowisku.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200 focus-within:border-amber-500 hover:border-amber-500 transition-colors"
          >
            <span
              class="text-xs font-bold uppercase tracking-widest text-amber-600 block mb-2"
              >05 / Bezpieczeństwo</span
            >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3">
              Audyt i pogotowie IT
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Naprawiam sypiącą się pocztę firmową (dbam o to, by wiadomości nie
              trafiały do spamu), odzyskuję dostępy do zapomnianych hostingów i
              domen, porządkuję bazy danych i konfiguruję bezpieczne kopie
              zapasowe (backupy).
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- [SEKCJA: USPRAWNIAM OBIEG / OFERUJĘ WSPARCIE] -->
  <section class="bg-white py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16">
        <!-- Kolumna 1 -->
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
            Usprawniam obieg informacji w firmie
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            Nie każda firma potrzebuje ERP, CRM i pięciu integracji.<br />
            Czasem wystarczy jedno dobrze zaprojektowane rozwiązanie, żeby w firmie
            zrobił się porządek.
          </p>
          <p class="text-slate-900 font-medium mb-4">
            Mogę pomóc, jeśli chcesz:
          </p>
          <ul class="space-y-3">
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >mieć jedno miejsce na zapytania i podstawowe dane,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >skrócić czas między zapytaniem a odpowiedzią,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >uporządkować statusy zleceń,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >ograniczyć ręczne przepisywanie danych,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >połączyć kilka prostych narzędzi w jeden działający proces.</span
              >
            </li>
          </ul>
        </div>

        <!-- Kolumna 2 -->
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
            Oferuję wsparcie IT i porządki techniczne
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6">
            W wielu firmach największym problemem nie jest brak nowego systemu,
            tylko bałagan w tym, co już istnieje.
          </p>
          <p class="text-slate-900 font-medium mb-4">
            Pomagam m.in. w takich sprawach jak:
          </p>
          <ul class="space-y-3 mb-6">
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >konfiguracja i naprawa poczty e-mail,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >problemy z dostarczalnością wiadomości,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >uporządkowanie hostingu, domeny i dostępów,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >odzyskanie kontroli nad stroną lub usługami,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >formularze, które nie działają albo nie wysyłają wiadomości,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >kopie zapasowe,</span
              >
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0 mt-2">
              </div>
              <span class="text-slate-600 text-sm md:text-base"
                >podstawowe bezpieczeństwo i techniczny porządek.</span
              >
            </li>
          </ul>
          <p
            class="text-slate-800 text-sm italic border-l-2 border-slate-200 pl-3"
          >
            Jeśli coś blokuje codzienną pracę, najpierw trzeba to ustabilizować.<br
            />Dopiero potem ma sens rozbudowa.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- [SEKCJA: WDRAŻAM NARZĘDZIA I AUTOMATYZACJE (SIATKA)] -->
  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-8">
        Wdrażam narzędzia i automatyzacje
      </h2>

      <blockquote
        class="pl-4 border-l-4 border-amber-500 text-lg md:text-xl text-slate-700 italic mb-12"
      >
        “Automatyzacja to nie tylko domena wielkich fabryk. Nawet mały warsztat
        może odzyskać 5-10 godzin tygodniowo na samym liczeniu ofert i
        ogarnianiu papierów”.
      </blockquote>

      <div class="grid sm:grid-cols-2 gap-4">
        <div
          class="flex items-start gap-4 p-5 bg-white border border-slate-200/70 rounded shadow-sm hover:shadow-md transition-shadow"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 text-amber-600 shrink-0 mt-1"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
              d="M14 3v4a1 1 0 0 0 1 1h4"></path><path
              d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"
            ></path><path d="M9 15l2 2l4 -4"></path></svg
          >
          <div>
            <h3 class="text-slate-900 font-bold mb-1 text-base">
              Formularz zapytania, który zbiera komplet danych
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Zamiast maili bez wymiarów, materiału i ilości — klient wypełnia
              formularz, który od razu zbiera to, co potrzebne do wstępnej
              oceny.
            </p>
          </div>
        </div>

        <div
          class="flex items-start gap-4 p-5 bg-white border border-slate-200/70 rounded shadow-sm hover:shadow-md transition-shadow"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 text-amber-600 shrink-0 mt-1"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><rect
              x="4"
              y="3"
              width="16"
              height="18"
              rx="2"></rect><rect x="8" y="7" width="8" height="3" rx="1"
            ></rect><line x1="8" y1="14" x2="8" y2="14.01"></line><line
              x1="12"
              y1="14"
              x2="12"
              y2="14.01"></line><line x1="16" y1="14" x2="16" y2="14.01"
