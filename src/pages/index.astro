  <!-- [SEKCJA: CTA KOŃCOWE / KONTAKT] -->
  <section id="kontakt" class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="max-w-3xl">
      <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
        Masz temat, który od dawna odkładasz?
      </h3>

      <p class="text-slate-600 text-base md:text-lg mb-8 leading-relaxed">
        Strona internetowa wymaga odświeżenia? Formularz kontaktowy gubi
        wiadomości? A może czujesz, że zbyt dużo czasu marnujesz na ręczne
        liczenie ofert i układanie dokumentów?
      </p>

      <div
        class="bg-white border border-slate-200 p-6 md:p-8 rounded-lg shadow-sm"
      >
        <p class="text-sm text-slate-500 mb-6 font-medium">
          Opisz krótko swoją sytuację. Przeanalizuję problem i odpowiem
          szczerze, jak mogę Ci pomóc oraz ile to będzie kosztować.
        </p>

        <!-- Profesjonalny i czysty formularz kontaktowy -->
        <form
          action="#"
          method="POST"
          class="space-y-4"
          onsubmit="event.preventDefault();"
        >
          <div>
            <label
              for="message"
              class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2"
              >Twoja wiadomość / opis problemu</label
            >
            <textarea
              id="message"
              rows="4"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-all text-sm resize-none"
              placeholder="Np. Prowadzę warsztat CNC. Moja strona słabo wyświetla się na telefonach, a wyceny liczę ręcznie w Excelu i schodzi mi na to zbyt wiele czasu..."
            ></textarea>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label
                for="email"
                class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2"
                >Adres e-mail</label
              >
              <input
                type="email"
                id="email"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-all text-sm"
                placeholder="twoj@email.pl"
              />
            </div>
            <div class="flex items-end">
              <button
                type="submit"
                class="w-full inline-flex justify-center items-center px-6 py-3 bg-slate-900 text-white font-medium rounded hover:bg-slate-800 transition-colors shadow-sm cursor-pointer"
              >
                Napisz do mnie
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</PageLayout>
