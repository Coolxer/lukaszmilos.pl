---
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import Banner from "@components/widgets/Banner.astro";
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import Prose from "@components/ui/Prose.astro";
import MyImage from "@components/ui/MyImage.astro";
import heroImg from "@assets/images/pages/lukasz-milos.webp";
import Compliments from "@components/sections/Compliments.astro";

const meta = {
  title: "Łukasz Miłoś | Strony internetowe i automatyzacje",
  description:
    "Inżynier IT, który rozumie warsztat. Tworzę szybkie strony WWW i automatyzacje procesów dla małych firm oraz rzemiosła. Sprawdź, jak mogę Ci pomóc.",
};
---

<BaseLayout meta={meta}>
  <Banner />
  <div class="w-full flex justify-center">
    <div class="flex flex-col min-h-screen justify-between w-full">
      <Navbar />
      <main class="w-full block">
        {/* ── HERO ──────────────────────────────────────────────── */}
        <Section heroSection>
          <div class="flex flex-col gap-10 animate-reveal">
            <div class="flex flex-col gap-4">
              <h1
                class="text-h0-hero text-base-content font-black"
                style="font-family: var(--font-space-grotesk), system-ui, sans-serif;"
              >
                Cześć,
              </h1>
              <p
                class="text-2xl md:text-3xl text-base-content/60 font-light leading-relaxed tracking-tight max-w-3xl"
              >
                Nazywam się <span class="text-base-content font-semibold"
                  >Łukasz Miłoś</span
                >. Działam na styku wytwarzania, technologii, stron
                internetowych i automatyzacji.
              </p>
            </div>

            <div class="flex flex-wrap gap-3">
              <Button link="oferta" class="btn-primary">Zobacz ofertę</Button>
              <Button link="kontakt" class="btn-ghost btn-outline"
                >Skontaktuj się</Button
              >
            </div>

            <div
              class="rounded-2xl overflow-hidden bg-base-200 border border-base-content/8 aspect-video sm:aspect-[21/9] group animate-reveal-delay"
            >
              <MyImage
                img={heroImg}
                alt="Łukasz Miłoś — inżynier IT"
                loading="eager"
                size="w-full h-full"
                aspect="aspect-auto"
                rounded="rounded-none"
                shadow=""
                class="object-cover object-[20%_20%] grayscale-[15%] group-hover:scale-[1.01] transition-transform duration-700"
              />
            </div>
          </div>
        </Section>

        {/* ── KIM JESTEM ────────────────────────────────────────── */}
        <Section
          id="o-mnie"
          preLabel="O mnie"
          class="border-t border-base-content/8"
        >
          <Heading tag="h2" look="h2" slot="heading"
            >Inżynier IT, który rozumie warsztat</Heading
          >
          <Prose>
            <p>
              Skończyłem studia informatyczne z wyróżnieniem, ale
              <strong>nie jestem tylko typowym informatykiem</strong>.
            </p>
            <p>
              Pracuję też ręcznie — w warsztacie, z narzędziami. Zbudowałem
              własną drukarkę 3D, zaprojektowałem i stworzyłem sterowanie do
              ostrzarki narzędzi CNC.
            </p>
            <p>
              To daje mi perspektywę, której brakuje większości osób w branży.
              Doceniam ludzi, którzy coś wytwarzają (części, maszyny,
              konstrukcje).
            </p>
          </Prose>
        </Section>

        {/* ── CO ROBIĘ ──────────────────────────────────────────── */}
        <Section
          id="zakres"
          preLabel="Zakres"
          class="border-t border-base-content/8"
        >
          <Heading tag="h2" look="h2" slot="heading">Co robię?</Heading>
          <div class="flex flex-col gap-8">
            <ul
              class="flex flex-col gap-5 text-xl text-base-content/60 font-light leading-relaxed"
            >
              <li>
                <span class="font-semibold text-base-content"
                  >W świecie cyfrowym:</span
                >{" "}
                Usprawniam lub buduję strony internetowe, piszę skrypty, automatyzacje,
                proste programy CAM, rysunki CAD, przygotowuję instrukcje i proste
                grafiki.
              </li>
              <li>
                <span class="font-semibold text-base-content"
                  >W świecie fizycznym:</span
                >{" "}
                Naprawiam, tnę, szlifuję, wiercę, gwintuję, skręcam i podpinam przewody.
              </li>
            </ul>

            <!-- <div class="border-t border-base-content/8 pt-8">
              <p
                class="text-sm font-mono uppercase tracking-[0.2em] text-base-content/40 mb-5"
              >
                Przykłady projektów
              </p>
              <div class="flex flex-wrap gap-3">
                <Button link="portfolio" class="btn-outline btn-sm"
                  >Sterowanie CNC</Button
                >
                <Button link="portfolio" class="btn-outline btn-sm"
                  >Dedykowany kalkulator</Button
                >
                <Button link="portfolio" class="btn-outline btn-sm"
                  >Druk 3D</Button
                >
              </div>
            </div> -->
          </div>
        </Section>

        {/* ── OFERTA ────────────────────────────────────────────── */}
        <Section
          id="wspolpraca"
          preLabel="Współpraca"
          class="border-t border-base-content/8"
        >
          <Heading tag="h2" look="h2" slot="heading"
            >Czy mogę Ci jakoś pomóc?</Heading
          >

          <p
            class="text-xl text-base-content/60 font-light leading-relaxed tracking-tight max-w-2xl"
          >
            Pomagam uporządkować i rozwinąć technologiczną stronę Twojego
            biznesu. Moje usługi kieruję do małych firm,{" "}
            <span class="text-base-content font-medium"
              >ze szczególnym uwzględnieniem branż technicznych i rzemiosła</span
            >.
          </p>

          <ul
            class="flex flex-col gap-4 text-xl text-base-content/60 font-light leading-relaxed"
          >
            <li>
              <span class="font-semibold text-base-content">Strony WWW</span>{
                " "
              }
              — proste, szybkie, czytelne dla Twoich klientów.
            </li>
            <li>
              <span class="font-semibold text-base-content">Automatyzacje</span
              >{" "}
              — uwalnianie czasu z powtarzalnych zadań, wycen i dokumentów.
            </li>
          </ul>

          <!-- <div
            class="bg-base-200 border border-base-content/8 p-8 md:p-10 rounded-2xl flex flex-col gap-5"
          >
            <p class="text-base-content text-lg font-light leading-relaxed">
              <strong
                >Dla niektórych branż mam specjalne, gotowe rozwiązania!</strong
              >{" "}
              Jeśli działasz w obróbce metalu lub robisz ogrodzenia, sprawdź dedykowane
              systemy wycen, które stworzyłem:
            </p>
            <div class="flex flex-wrap gap-3">
              <Button link="oferta/cnc" class="btn-outline btn-sm"
                >Zobacz rozwiązania dla CNC</Button
              >
              <Button link="oferta/ogrodzenia" class="btn-outline btn-sm"
                >Zobacz rozwiązania dla Ogrodzeń</Button
              >
            </div>
          </div> -->
        </Section>

        {/* ── JAK PRACUJĘ ───────────────────────────────────────── */}
        <Section preLabel="Metodologia" class="border-t border-base-content/8">
          <Heading tag="h2" look="h2" slot="heading">Jak pracuję?</Heading>
          <ul class="flex flex-col">
            {
              [
                {
                  title: "Słucham i analizuję",
                  description:
                    "Zanim cokolwiek zaproponuję, dokładnie rozumiem Twoją sytuację i potrzeby.",
                },
                {
                  title: "Wybieram najprostsze skuteczne rozwiązanie",
                  description:
                    "Nie najdroższe, nie najmodniejsze — po prostu to, które działa i ma sens.",
                },
                {
                  title: "Komunikuję jasno",
                  description:
                    "Mówię, co robię, ile to zajmie i co może pójść nie tak.",
                },
                {
                  title: "Nie obiecuję rzeczy, których nie mogę dostarczyć",
                  description:
                    "Jeśli czegoś nie da się zrobić w Twoim budżecie lub terminie — powiem wprost.",
                },
              ].map((p) => (
                <li class="flex flex-col gap-1 border-t border-base-content/10 py-5">
                  <span class="font-semibold text-base-content text-lg">
                    {p.title}
                  </span>
                  <span class="text-base-content/60 font-light leading-relaxed">
                    {p.description}
                  </span>
                </li>
              ))
            }
          </ul>
        </Section>

        {/* ── OPINIE ────────────────────────────────────────────── */}
        <Compliments variant="secondary" />

        {/* ── KONTAKT ───────────────────────────────────────────── */}
        <Section class="border-t border-base-content/8">
          <div
            class="bg-base-200 border border-base-content/8 rounded-2xl p-8 md:p-12 flex flex-col gap-6"
          >
            <Heading tag="h2" look="h2">Kontakt</Heading>
            <p
              class="text-xl text-base-content/60 font-light leading-relaxed max-w-lg"
            >
              Jeśli coś w Twojej firmie nie działa, chcesz coś wdrożyć,
              usprawnić lub po prostu pogadać o projekcie — napisz do mnie.
            </p>
            <div>
              <Button link="kontakt" class="btn-primary rounded-full px-8"
                >Napisz do mnie</Button
              >
            </div>
          </div>
        </Section>
      </main>
      <Footer />
    </div>
  </div>
</BaseLayout>
