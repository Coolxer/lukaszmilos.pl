---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import Banner from "@components/widgets/Banner.astro";
import Container from "@components/layout/Container.astro";
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import MyImage from "@components/ui/MyImage.astro";
import FAQ from "@components/ui/FAQ.astro";
import Compliments from "@components/sections/Compliments.astro";
import heroImg from "@assets/images/pages/lukasz-milos.webp";
import websiteClarityImg from "@assets/images/pages/website-clarity-v1.png";
import processFlowImg from "@assets/images/pages/process-flow-v1.png";
import { industries } from "@data/industries";
import caseImg from "@assets/images/portfolio/devesol/devesol-pokaz.webp";

const meta = {
  title: "Strony i narzędzia dla małych firm technicznych",
  description:
    "Pomagam małym firmom tworzyć czytelne strony oraz praktyczne narzędzia, które usprawniają codzienną pracę.",
};

const faqItems = [
  {
    question: "Czy muszę mieć gotowy pomysł na projekt?",
    answer:
      "Nie. Wystarczy opisać firmę, cel i to, co dziś przeszkadza. Wspólnie ustalimy, czy potrzebna jest strona, narzędzie czy po prostu mała poprawa procesu.",
  },
  {
    question: "Czy pracujesz tylko z firmami technicznymi?",
    answer:
      "Nie. To środowisko jest mi szczególnie bliskie, ale pracuję wszędzie tam, gdzie przydaje się jasna komunikacja i praktyczne podejście do technologii.",
  },
  {
    question: "Czy da się zacząć od małego zakresu?",
    answer:
      "Tak. Często najlepszym początkiem jest pojedyncza strona, formularz albo test rozwiązania zamiast rozbudowanego systemu.",
  },
  {
    question: "Czy po wdrożeniu można rozwijać rozwiązanie?",
    answer:
      "Tak, jeśli kolejne kroki mają uzasadnienie. Nie dokładam funkcji dla samego dokładania.",
  },
];
---

<BaseLayout meta={meta}>
  <Banner />
  <div class="flex min-h-screen w-full flex-col">
    <Navbar />
    <main>
      <section
        class="home-hero pt-8 pb-12 md:pt-12 md:pb-16 lg:min-h-[calc(100dvh-4rem)] lg:pt-16"
      >
        <Container size="max-w-7xl">
          <div
            class="grid gap-8 md:gap-10 lg:grid-cols-[1fr_.82fr] lg:items-center lg:gap-16"
          >
            <div
              class="animate-reveal flex max-w-2xl flex-col items-start gap-6 md:gap-7"
            >
              <p class="hero-welcome">
                <Icon name="tabler:hand-finger" class="size-4" /> Cześć, jestem Łukasz
                Miłoś.
              </p>
              <h1 class="home-hero-title font-semibold">
                Wdrażam technologie. Upraszczam codzienną pracę.
              </h1>
              <p
                class="max-w-xl text-lg leading-8 text-base-content/68 md:text-xl"
              >
                Interesuje mnie to, jak technologia pomaga małej firmie pokazać
                swoją pracę i poradzić sobie z powtarzalnymi zadaniami.
                Szczególnie bliskie są mi firmy, które coś wykonują, produkują
                lub naprawiają.
              </p>
              <div class="flex flex-wrap gap-3">
                <Button link="kontakt" class="btn-primary px-6"
                  >Opisz, co chcesz usprawnić</Button
                ><Button link="oferta" class="btn-outline px-6"
                  >Zobacz, czym się zajmuję</Button
                >
              </div>
            </div>
            <div class="animate-reveal-delay w-full max-w-[31rem] lg:ml-auto">
              <div class="portrait-panel">
                <MyImage
                  img={heroImg}
                  alt="Łukasz Miłoś"
                  loading="eager"
                  fetchpriority="high"
                  size="h-full w-full"
                  aspect="aspect-[4/5]"
                  rounded="rounded-none"
                  shadow=""
                  sizes="(max-width: 550px) 90vw, (max-width: 1023px) 496px, 38vw"
                  class="h-full w-full object-cover object-[38%_18%]"
                />
              </div>
              <div class="home-hero-note p-5 md:p-6">
                <p class="text-lg font-medium leading-7">
                  Zbudowałem własną drukarkę 3D i sterowanie do ostrzarki
                  narzędzi CNC. Lubię poznawać pracę ludzi, którzy coś
                  wytwarzają.
                </p>
              </div>
            </div>
          </div>
        </Container>
      </section>

      <Section
        id="oferta"
        containerSize="max-w-7xl"
        innerDivClasses="flex flex-col gap-10"
      >
        <div class="max-w-2xl">
          <p class="mb-4 text-sm font-semibold text-primary">
            Czym się zajmuję?
          </p><Heading tag="h2" look="h2"
            >Porządkuję to, co w firmie dzieje się online i wewnątrz.</Heading
          ><p class="mt-5 text-lg leading-8 text-base-content/68">
            Nie musisz wiedzieć, jakiego rozwiązania potrzebujesz. Możesz
            opowiedzieć, co dziś zajmuje za dużo czasu albo czego brakuje Twojej
            stronie.
          </p>
        </div>
        <div class="grid gap-5 lg:grid-cols-2">
          <a
            href="/oferta/strony-www/"
            class="service-tile service-tile--feature group overflow-hidden"
            ><div class="service-illustration">
              <MyImage
                img={websiteClarityImg}
                alt="Ilustracja czytelnej strony internetowej"
                size="h-full w-full"
                layout="object-contain"
                aspect="aspect-auto"
                rounded="rounded-none"
                shadow=""
                sizes="(max-width: 1024px) 90vw, 50vw"
                class="h-full w-full p-6 md:p-8"
              />
            </div><div class="flex h-full flex-col justify-between p-7 lg:p-9">
              <div>
                <h3 class="text-h3">
                  Poprawiam strony, które już działają, i tworzę nowe.
                </h3><p class="mt-4 max-w-lg leading-7 text-base-content/65">
                  Chodzi o jasną ofertę, przykłady pracy i łatwy następny krok
                  dla klienta.
                </p>
              </div><span
                class="mt-9 flex items-center gap-2 font-semibold text-primary"
                >Strony internetowe <Icon
                  name="tabler:arrow-up-right"
                  class="size-5"
                /></span
              >
            </div></a
          >
          <a
            href="/oferta/systemy-i-automatyzacje/"
            class="service-tile group overflow-hidden"
            ><div class="service-illustration service-illustration--blue">
              <MyImage
                img={processFlowImg}
                alt="Ilustracja uporządkowanego przepływu danych"
                size="h-full w-full"
                layout="object-contain"
                aspect="aspect-auto"
                rounded="rounded-none"
                shadow=""
                sizes="(max-width: 1024px) 90vw, 50vw"
                class="h-full w-full p-6 md:p-8"
              />
            </div><div class="flex h-full flex-col justify-between p-7 lg:p-9">
              <div>
                <h3 class="text-h3">
                  Upraszczam powtarzalne zadania za kulisami.
                </h3><p class="mt-4 leading-7 text-base-content/65">
                  Gdy ktoś ciągle przygotowuje dokumenty lub treści,
                  przepisuje dane albo szuka informacji, sprawdzam, czy można
                  uprościć ten fragment pracy.
                </p>
              </div><span
                class="mt-9 flex items-center gap-2 font-semibold text-primary"
                >Narzędzia i automatyzacje <Icon
                  name="tabler:arrow-up-right"
                  class="size-5"
                /></span
              >
            </div></a
          >
        </div>
      </Section>

      <Section
        id="branze"
        variant="secondary"
        containerSize="max-w-7xl"
        innerDivClasses="flex flex-col gap-10"
      >
        <div class="max-w-2xl">
          <Heading tag="h2" look="h2"
            >Szczególnie interesują mnie firmy, które coś tworzą, wykonują lub
            naprawiają.</Heading
          ><p class="mt-5 text-lg leading-8 text-base-content/68">
            To bliski mi kierunek, ale nie jedyna grupa, z którą pracuję. Każdy
            projekt zaczyna się od poznania konkretnej pracy i potrzeb.
          </p>
        </div>
        <div class="industry-grid">
          {
            industries.map((industry, index) => (
              <article
                class:list={[
                  "industry-card",
                  industry.link && "industry-card--linked",
                  index === 0 && "industry-card--feature",
                ]}
              >
                <>
                  <div class="industry-card-media">
                    <MyImage
                      img={industry.image}
                      alt={industry.alt}
                      size="h-full w-full"
                      layout="object-contain"
                      aspect="aspect-auto"
                      rounded="rounded-none"
                      shadow=""
                      sizes="(max-width: 768px) 90vw, 44vw"
                      class="h-full w-full p-5"
                    />
                  </div>
                  <div class="p-6">
                    <h3 class="text-h3">{industry.title}</h3>
                    <p class="mt-3 leading-7 text-base-content/65">
                      {industry.text}
                    </p>
                    {industry.link && (
                      <a
                        href={industry.link}
                        aria-label={`Zobacz ofertę dla branży: ${industry.title}`}
                        class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary"
                      >
                        Zobacz możliwości{" "}
                        <Icon name="tabler:arrow-up-right" class="size-4" />
                      </a>
                    )}
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </Section>

      <Section
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:gap-20"
      >
        <div>
          <Heading tag="h2" look="h2"
            >Skąd zainteresowanie takimi firmami?</Heading
          >
        </div>
        <div class="max-w-2xl space-y-5 text-lg leading-8 text-base-content/68">
          <p>
            Znam ten świat z ciekawości i własnej pracy. Skończyłem studia
            informatyczne, a poza komputerem zajmuję się prostymi pracami
            warsztatowymi, a czasami także elektroniką i projektami CNC.
          </p>
          <p>
            Zbudowałem własną drukarkę 3D oraz zaprojektowałem i stworzyłem
            sterowanie do ostrzarki narzędzi CNC. Doceniam ludzi, którzy
            wytwarzają części, maszyny i konstrukcje.
          </p>
          <p>
            Nie zakładam, że znam proces Twojej firmy. Chętnie zobaczę, jak
            naprawdę pracujesz.
          </p>
        </div>
      </Section>

      <Section
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-10 lg:grid-cols-[1.03fr_.97fr] lg:items-center lg:gap-16"
      >
        <div class="home-case">
          <figure>
            <MyImage
              img={caseImg}
              alt="Widok strony firmy Devesol po modernizacji"
              size="h-full w-full"
              layout="object-contain"
              aspect="aspect-auto"
              rounded="rounded-none"
              shadow=""
              sizes="(max-width: 1024px) 90vw, 48vw"
              class="h-full w-full p-4"
            />
          </figure>
        </div>
        <div class="max-w-xl">
          <p class="mb-4 text-sm font-semibold text-primary">
            Przykład realizacji
          </p><Heading tag="h2" look="h2"
            >Strona, która porządkuje ofertę firmy technicznej.</Heading
          ><p class="mt-5 text-lg leading-8 text-base-content/68">
            W projekcie Devesol uporządkowałem strukturę i treści istniejącej
            strony WordPress. To przykład modernizacji bez budowania wszystkiego
            od nowa.
          </p><div class="mt-8">
            <Button
              link="/portfolio/modernizacja-strony-devesol/"
              rawLink
              class="btn-outline px-6">Zobacz case study</Button
            >
          </div>
        </div>
      </Section>

      <Compliments variant="secondary" />

      <Section
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:items-start lg:gap-16"
      >
        <div>
          <Heading tag="h2" look="h2"
            >Najczęstsze pytania przed pierwszą rozmową.</Heading
          >
        </div>
        <FAQ items={faqItems} />
      </Section>

      <Section containerSize="max-w-7xl"
        ><div
          class="contact-panel grid gap-8 p-8 md:p-12 lg:grid-cols-[1fr_auto] lg:items-end"
        >
          <div class="max-w-3xl">
            <Heading tag="h2" look="h2"
              >Masz temat, który warto uporządkować?</Heading
            ><p class="mt-5 text-lg leading-8 text-white/84">
              Napisz, czym zajmuje się firma i co dziś zabiera zbyt dużo czasu.
              Sprawdzimy, od czego warto zacząć.
            </p>
          </div><Button
            link="kontakt"
            class="btn border-0 bg-white px-7 text-primary hover:bg-base-100"
            >Napisz do mnie</Button
          >
        </div></Section
      >
    </main>
    <Footer />
  </div>
</BaseLayout>
