---
import PageLayout from "@layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import config from "~/data/consts.json";
import { type Meta, type Schema } from "@components/core/MySEO.astro";
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Form from "@components/widgets/Form.astro";
import heroImage from "@assets/images/pages/industry-b2b-v1.png";

const meta: Meta = {
  title: "Kontakt",
  description:
    "Opisz temat, który chcesz uporządkować. Odpowiem i pomogę ustalić sensowny pierwszy krok.",
};
const schema: Schema = {
  "@context": "http://schema.org",
  "@type": "ContactPage",
  url: "https://lukaszmilos.pl/kontakt",
  breadcrumb: "Kontakt",
  mainEntity: {
    "@type": "ContactPoint",
    contactType: "customer service",
    areaServed: "PL",
  },
};
---

<PageLayout
  meta={meta}
  schema={schema}
  {heroImage}
  heroImageAlt="Ilustracja wspólnego omawiania pomysłu"
  pageTitle="Opowiedz mi, co chcesz poprawić."
  pageDescription="Nie potrzebujesz specyfikacji. Napisz, czym zajmuje się firma, jak wygląda obecny sposób pracy i co regularnie sprawia kłopot. Możesz dodać link do strony lub przykład bez danych klientów."
>
  <Section
    variant="secondary"
    containerSize="max-w-7xl"
    innerDivClasses="grid gap-10 lg:grid-cols-[.78fr_1.22fr] lg:items-start lg:gap-16"
  >
    <div class="max-w-md">
      <p class="mb-4 text-sm font-semibold text-primary">Kontakt</p><Heading
        tag="h2"
        look="h2">Wiadomość wystarczy na początek.</Heading
      ><p class="mt-5 leading-8 text-base-content/68">
        Po otrzymaniu wiadomości odpowiem, czy to temat, w którym mogę pomóc, i
        o co trzeba dopytać przed propozycją zakresu. Koszt i termin etapu
        ustalimy przed rozpoczęciem pracy.
      </p>
    </div>
    <div class="contact-form-panel"><Form /></div>
  </Section>

  <Section containerSize="max-w-7xl" innerDivClasses="flex flex-col gap-10">
    <div class="max-w-2xl">
      <Heading tag="h2" look="h2">Możesz też napisać bezpośrednio.</Heading>
    </div>
    <div class="contact-details-grid">
      <article class="contact-detail-card">
        <div class="contact-detail-icon">
          <Icon name="tabler:mail" class="size-6" />
        </div><h3 class="mt-7 text-h4">E-mail</h3><div
          class="mt-4 flex flex-col gap-2"
        >
          {
            config.company.email.map((email) => (
              <a
                href={`mailto:${email}`}
                class="inline-flex min-h-11 items-center font-medium text-primary hover:underline"
              >
                {email}
              </a>
            ))
          }
        </div>
      </article>
      <article class="contact-detail-card">
        <div class="contact-detail-icon">
          <Icon name="tabler:brand-linkedin" class="size-6" />
        </div><h3 class="mt-7 text-h4">Znajdziesz mnie też tutaj</h3><div
          class="mt-5 flex flex-wrap gap-2"
        >
          {
            config.socials.map((social) => (
              <a
                href={social.href}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
              >
                <Icon name={social.icon} class="size-5" />
              </a>
            ))
          }
        </div>
      </article>
      <article class="contact-detail-card contact-detail-card--company">
        <div class="contact-detail-icon">
          <Icon name="tabler:building" class="size-6" />
        </div><h3 class="mt-7 text-h4">Dane firmy</h3><p
          class="mt-4 font-semibold"
        >
          {config.company.name}
        </p><p class="mt-1 text-base-content/65">
          {config.company.address}
        </p><div class="mt-6 grid gap-4 sm:grid-cols-2">
          <p>
            <span class="block text-sm text-base-content/70">NIP</span><span
              class="font-medium">{config.company.nip}</span>
          </p><p>
            <span class="block text-sm text-base-content/70">REGON</span><span
              class="font-medium">{config.company.regon}</span>
          </p>
        </div>
      </article>
    </div>
  </Section>
</PageLayout>
