  <section id="kontakt" class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="max-w-3xl">
      <h3 class="text-2xl md:text-3xl font-bold text-slate-900 mb-4">
        Twoja strona potrzebuje nowego podejścia?
      </h3>

      <p class="text-slate-600 text-base md:text-lg mb-8 leading-relaxed">
        Opisz krótko swój park maszynowy, profil działalności lub podeślij link
        do obecnej strony. Przeanalizuję sytuację i zaproponuję konkretne
        rozwiązania.
      </p>

      <div
        class="bg-white border border-slate-200 p-6 md:p-8 rounded-lg shadow-xs"
      >
        <form
          action="#"
          method="POST"
          class="space-y-4"
          onsubmit="event.preventDefault();"
        >
          <div>
            <label
              for="message"
              class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2"
              >Opis firmy / obecna strona</label
            >
            <textarea
              id="message"
              rows="4"
              class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-all text-sm resize-none"
              placeholder="Np. Nasza stolarnia potrzebuje prostej strony z prezentacją maszyn i formularzem zapytań..."
            ></textarea>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label
                for="email"
                class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2"
                >Adres e-mail</label
              >
              <input
                type="email"
                id="email"
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded text-slate-900 placeholder-slate-400 focus:outline-none focus:border-amber-500 focus:bg-white transition-all text-sm"
                placeholder="kontakt@twojafirma.pl"
              />
            </div>
            <div class="flex items-end">
              <button
                type="submit"
                class="w-full inline-flex justify-center items-center px-6 py-3 bg-slate-900 text-white font-medium rounded hover:bg-slate-800 transition-colors shadow-sm cursor-pointer"
              >
                Porozmawiajmy o projekcie
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
