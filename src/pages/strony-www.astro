---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

import { type Meta, type Schema } from "@components/core/MySEO.astro";
import { PORTFOLIO_CATEGORIES } from "~/content/schemas";

import PageLayout from "@layouts/PageLayout.astro";

import HeroImg from "@assets/images/pages/strony-www/strona-www.svg";
import MobileSpeedImg from "@assets/images/pages/strony-www/mobile.webp";
import DesktopSpeedImg from "@assets/images/pages/strony-www/desktop.webp";

import Section from "@components/layout/Section.astro";
import Grid from "@components/layout/Grid.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import MyImage from "@components/ui/MyImage.astro";
import IconList from "@components/ui/IconList.astro";

import PortfolioCard from "@components/collection/PortfolioCard.astro";
import ReviewCard from "@components/collection/ReviewCard.astro";

import FAQ from "@components/ui/FAQ.astro";
import CTA from "~/components/sections/CTA.astro";
import Compliments from "~/components/sections/Compliments.astro";

const meta: Meta = {
  title: "Strony internetowe bez bólu głowy",
  description:
    "Buduję strony, które po prostu działają. Bez ciągłych aktualizacji, abonamentów i stresu. Skup się na biznesie – resztą zajmie się Twoja nowa witryna.",
};

const schema: Schema = {
  "@context": "https://schema.org",
  "@type": "WebService",
  name: "Tworzenie szybkich i bezpiecznych stron internetowych",
  description:
    "Usługa budowy nowoczesnych stron internetowych w oparciu o architekturę Jamstack (Astro), zapewniających szybkość, bezpieczeństwo i niezależność od platform abonamentowych.",
  provider: {
    "@type": "Person",
    name: "Rola - Ekspert front-end",
  },
  serviceType: "Tworzenie stron internetowych",
  areaServed: "PL",
};

const relatedProjects = (
  await getCollection("portfolio", ({ data }) => {
    return (
      !data.draft && data.category && data.category === PORTFOLIO_CATEGORIES[0]
    );
  })
).slice(0, 2);

const relatedReviews = (
  await getCollection("reviews", ({ data }) => {
    return (
      !data.draft &&
      data.service &&
      data.service.includes(PORTFOLIO_CATEGORIES[0])
    );
  })
).slice(0, 2);

const monthlyFee = 50;
---

<PageLayout meta={meta} schema={schema}>
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-3xl relative">
      <div
        class="absolute -left-6 top-0 bottom-0 w-[2px] bg-slate-200/50 hidden md:block"
      >
        <div class="h-16 w-full bg-amber-500 rounded-full"></div>
      </div>

      <div
        class="inline-flex items-center gap-2 px-3 py-1 bg-slate-100 text-slate-600 rounded text-xs font-medium mb-6 uppercase tracking-wider border border-slate-200/60"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-3.5 h-3.5 text-amber-500"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
            d="M7 10l5 -6l5 6v10a1 1 0 0 1 -1 1h-8a1 1 0 0 1 -1 -1z"
          ></path><path d="M7 10l5 4l5 -4" stroke-dasharray="2 2"></path></svg
        >
        Dedykowane dla branży technicznej i produkcyjnej
      </div>

      <h1
        class="text-4xl md:text-6xl font-bold text-slate-900 leading-[1.1] mb-6"
      >
        Strony internetowe dla małych firm
      </h1>

      <p
        class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-2xl mb-10"
      >
        Szybkie, czytelne i dobrze działające na telefonie. Poprawiam istniejące
        strony albo buduję nowe — tak, żeby Twój klient od razu wiedział, <span
          class="text-slate-900 font-medium bg-amber-500/10 px-1.5 py-0.5 rounded"
          >co robisz, na czym pracujesz</span
        > i jak się z Tobą skontaktować.
      </p>

      <div
        class="p-4 bg-white border-l-4 border-amber-500 border-y border-r border-slate-200/70 rounded-r shadow-xs text-sm md:text-base font-medium text-slate-800"
      >
        Szczególnie strony internetowe dla małych firm technicznych i
        produkcyjnych.
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-10">
        <a
          href="#kontakt"
          class="inline-flex justify-center items-center px-6 py-3.5 bg-slate-900 text-white font-medium rounded hover:bg-slate-800 transition-colors shadow-sm group"
        >
          Zapytaj o nową stronę
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-4 h-4 ml-2 text-amber-400 group-hover:translate-x-0.5 transition-transform"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
              d="M5 12l14 0"></path><path d="M13 18l6 -6"></path><path
              d="M13 6l6 6"></path></svg
          >
        </a>
        <a
          href="#problemy"
          class="inline-flex justify-center items-center px-6 py-3.5 bg-white text-slate-700 font-medium rounded border border-slate-200 hover:bg-slate-50 transition-colors"
        >
          Typowe problemy stron
        </a>
      </div>
    </div>
  </section>

  <section
    id="problemy"
    class="bg-white border-y border-slate-200/60 py-24 md:py-32"
  >
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          Co najczęściej nie działa na stronie?
        </h2>

        <p class="text-base md:text-lg text-slate-600 leading-relaxed mb-10">
          Wiele stron firm technicznych ma podobne problemy, które bezpośrednio
          wpływają na zniecierpliwienie potencjalnych kontrahentów:
        </p>

        <div class="grid sm:grid-cols-2 gap-4 mb-10">
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >wolno się ładują</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >słabo działają na telefonie</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >pokazują za mało konkretów</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >nie prezentują dobrze usług, realizacji i swoich możliwości</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >nie zbierają sensownych zapytań</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >są trudne do aktualizacji</span
            >
          </div>
          <div
            class="flex items-start gap-3 p-4 bg-slate-50 border border-slate-200/50 rounded sm:col-span-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5 text-red-500 shrink-0 mt-0.5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
                d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path><path
                d="M12 9v4"></path><path d="M12 16v.01"></path></svg
            >
            <span class="text-slate-700 text-sm md:text-base"
              >nikt do końca nie wie, gdzie jest hosting, domena i kto ma dostęp</span
            >
          </div>
        </div>

        <div class="p-6 bg-amber-500/5 border border-amber-500/20 rounded-lg">
          <span
            class="text-xs font-bold uppercase tracking-widest text-amber-700 block mb-1"
            >Efekt jest prosty:</span
          >
          <p class="text-base md:text-lg text-slate-800 leading-relaxed">
            klient trafia na stronę, nie znajduje potrzebnych informacji i
            przechodzi dalej — albo dzwoni z pytaniami, na które strona powinna
            odpowiadać od razu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="max-w-3xl">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
        Jak mogę pomóc?
      </h2>
      <p class="text-slate-600 mb-12 text-base md:text-lg">
        Wdrażam konkretne ulepszenia i tworzę zaplecze internetowe dopasowane do
        Twoich realiów rynkowych:
      </p>

      <div class="space-y-4 max-w-2xl">
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >modernizacja i uporządkowanie obecnej strony</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >poprawa szybkości i wersji mobilnej</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >uporządkowanie treści i struktury</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >wdrożenie podstaw SEO technicznego</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >dodanie właściwych sekcji usług, realizacji innych ważnych
            branżowych elementów</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >formularz zapytania ofertowego z załącznikami</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >wersje językowe</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >katalog produktów lub prosty model „zapytaj o produkt”</span
          >
        </div>
        <div
          class="flex gap-4 items-start p-2 hover:bg-slate-100/50 rounded transition-colors"
        >
          <div class="w-2 h-2 rounded-full bg-amber-500 shrink-0 mt-2.5"></div>
          <span class="text-slate-700 text-sm md:text-base"
            >CMS do samodzielnej edycji albo lżejsze rozwiązanie typu „włącz i
            zapomnij”</span
          >
        </div>
      </div>
    </div>
  </section>

  <section
    class="bg-amber-500/[0.03] border-y border-slate-200/60 py-24 md:py-32"
  >
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-12">
          Co dostajesz?
        </h2>

        <div class="space-y-12">
          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Szybszą i stabilniejszą stronę
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Strona ma działać sprawnie i przewidywalnie. Nie irytować
              użytkownika ładowaniem, nie wyświetlać błędów, nie znikać raz na
              tydzień.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Działającą wersję mobilną
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Twój klient bardzo często trafia na stronę z telefonu — na hali, w
              aucie, między spotkaniami. Strona musi działać dobrze na małym
              ekranie, a nadrzędnym celem nie jest to, by „jakoś się
              wyświetlała", ale by była w pełni intuicyjna.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Porządne fundamenty pod SEO
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Szybkość, struktura nagłówków, meta tagi, sensowna architektura
              treści — to wszystko wpływa na widoczność w Google. Nie zajmuję
              się pozycjonowaniem, ale porządkuję techniczne podstawy, bez
              których SEO nie ma szans zadziałać.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Jasną prezentację Twojej oferty
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Twoja strona ma konkretnie pokazywać: co robisz, dla kogo, czy np.
              na jakich maszynach, z jakimi parametrami i jak się z Tobą
              skontaktować. Klient ma znaleźć odpowiedzi, zanim sięgnie po
              telefon.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Łatwiejszy rozwój
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              Zamiast strony, w której każda zmiana coś psuje, dostajesz
              uporządkowaną bazę. Jeśli chcesz sam edytować treści — zrobię to
              tak, żeby było wygodnie. Jeśli wolisz stronę typu „włącz i
              zapomnij" — przygotuję lżejsze rozwiązanie, które nie wymaga
              ciągłej opieki.
            </p>
          </div>

          <div
            class="relative pl-0 md:pl-8 border-l-2 border-slate-200/60 focus-within:border-amber-500 transition-colors"
          >
            <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
              Elementy dopasowane do branży
            </h3>
            <p class="text-slate-600 leading-relaxed text-sm md:text-base">
              W przypadku CNC jest to np. park maszynowy ze specyfikacjami,
              galeria realizacji, katalog produktów, rozbudowany formularz
              ofertowy, certyfikaty, referencje, itp.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-24 md:py-32">
    <div class="max-w-3xl">
      <span
        class="text-xs font-bold uppercase tracking-widest text-slate-400 block mb-2"
        >Interesuje Cię konkretna branża?</span
      >
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-10">
        Zobacz przykłady realizacji.
      </h2>

      <div
        class="p-8 border-2 border-dashed border-slate-200 rounded-lg text-center bg-white"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-8 h-8 text-slate-300 mx-auto mb-3"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path stroke="none" d="M0 0h24v240H0z" fill="none"></path><path
            d="M15 8h.01"></path><path
            d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z"
          ></path><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5"
          ></path><path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3"
          ></path></svg
        >
        <p class="text-sm font-medium text-slate-600">
          Projekty realizowane dla branży CNC, stolarni oraz zakładów
          produkcyjnych
        </p>
        <p class="text-xs text-slate-400 mt-1">
          Galeria w trakcie przygotowania. Skontaktuj się, aby otrzymać
          bezpośrednie linki do wdrożeń.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-900 text-white py-24 md:py-32">
    <div class="max-w-4xl mx-auto px-6">
      <div class="max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Czego nie robię
        </h2>
