---
import { Icon } from "astro-icon/components";
import BaseLayout from "@layouts/BaseLayout.astro";
import Navbar from "@components/layout/Navbar.astro";
import Footer from "@components/layout/Footer.astro";
import Banner from "@components/widgets/Banner.astro";
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";
import MyImage from "@components/ui/MyImage.astro";
import FAQ from "@components/ui/FAQ.astro";
import Compliments from "@components/sections/Compliments.astro";
import CTA from "@components/sections/CTA.astro";
import image from "@assets/images/pages/industry-sharpening-v2.png";

const meta = {
  title: "Usprawnienia dla ostrzarni i serwisów narzędzi",
  description:
    "Mniej dopytywania, szukania i ręcznego pilnowania zleceń. Praktyczne usprawnienia pracy ostrzarni i jej obecnej strony internetowej.",
};

const essentials = [
  [
    "Zakres usług",
    "Klient powinien bez zgadywania sprawdzić, jakie narzędzia przyjmujesz i gdzie kończy się zakres Twoich możliwości. Można pokazać rodzaje narzędzi, materiały, istotne ograniczenia albo możliwości parku maszynowego.",
  ],
  [
    "Dostarczenie narzędzi",
    "Adres, godziny, odbiór lokalny, wysyłka, zasady pakowania i informacja o tym, kto organizuje transport. Tylko te warianty, które rzeczywiście oferujesz.",
  ],
  [
    "Cena i termin",
    "Jeśli dla standardowych prac da się podać cenę lub przedział, warto to zrobić. Jeśli cena zależy od stanu narzędzia, strona powinna wyjaśniać, kiedy potwierdzasz ostateczny koszt i co dzieje się przy dodatkowej naprawie.",
  ],
  [
    "Aktualne realizacje",
    "Jeśli masz zdjęcia i materiały, ale brakuje czasu na publikowanie, można przede wszystkim uprościć sposób ich dodawania zamiast przebudowywać całą stronę.",
  ],
];

const otherImprovements = [
  {
    icon: "tabler:photo-up",
    title: "Realizacje na stronie bez siedzenia przy komputerze",
    text: "Robisz zdjęcia ciekawych prac i trafiają one na Facebooka, ale na stronie ostatnia realizacja ma kilka lat? Można uprościć ten proces. Wysyłasz zdjęcie i kilka informacji z telefonu, powstaje przygotowany wpis, a przed publikacją możesz go sprawdzić.",
  },
  {
    icon: "tabler:bell",
    title: "Informacja „gotowe do odbioru”",
    text: "Po zakończeniu pracy klient może dostać krótką wiadomość e-mail lub SMS. Nie musi to być rozbudowany panel ze śledzeniem każdego etapu, jeśli zwykłe „zlecenie jest gotowe” rozwiązuje problem.",
  },
  {
    icon: "tabler:tag",
    title: "Oznaczenie partii lub narzędzia",
    text: "Numer zlecenia, wydrukowana etykieta albo kod mogą pomóc połączyć fizyczne narzędzia z informacjami zapisanymi przy zleceniu. Sposób oznaczenia powinien odpowiadać temu, czego naprawdę trzeba pilnować.",
  },
  {
    icon: "tabler:history",
    title: "Historia dla stałych klientów",
    text: "Jeśli konkretne narzędzia wracają regularnie i da się je jednoznacznie rozpoznać, można zapisywać poprzednie ostrzenia, regeneracje lub uwagi. Nie ma potrzeby prowadzenia takiej historii dla każdego zlecenia.",
  },
  {
    icon: "tabler:truck-delivery",
    title: "Wysyłka i odbiór",
    text: "Jeśli obsługujesz klientów wysyłkowo, strona może jasno pokazywać sposób pakowania, adres, zasady transportu i potrzebne dane. Przy większej liczbie przesyłek można też uprościć przygotowanie etykiety albo zwrot narzędzi.",
  },
  {
    icon: "tabler:calendar-repeat",
    title: "Regularne odbiory od firm",
    text: "Jeśli jeździsz po narzędzia do stałych klientów, można uporządkować zgłoszenia odbioru, trasę albo przypomnienia o uzgodnionych terminach. System powinien wspierać ustalony sposób współpracy.",
  },
];

const questions = [
  {
    question: "Czy muszę zmieniać obecną stronę?",
    answer:
      "Zwykle nie. Formularz, informacje dla klientów albo łatwiejsze dodawanie realizacji często można dołożyć do tego, co już działa. Najpierw trzeba sprawdzić możliwości obecnej strony.",
  },
  {
    question: "Czy każdy klient będzie musiał korzystać z formularza?",
    answer:
      "Nie. Telefon i e-mail mogą zostać. Formularz ma sens przede wszystkim tam, gdzie regularnie brakuje danych albo gdzie stały klient chce szybciej zgłosić kolejną podobną partię.",
  },
  {
    question: "Czy da się automatycznie wycenić ostrzenie?",
    answer:
      "Przy bardzo powtarzalnych usługach można rozważyć kalkulator lub przygotowanie wstępnego szkicu ceny. Przy uszkodzeniu, regeneracji czy nietypowym narzędziu parametry i zdjęcie mogą pomóc w ocenie, ale nie zastępują decyzji osoby, która zna się na danej pracy.",
  },
  {
    question: "Czy każde narzędzie musi dostać kod QR?",
    answer:
      "Nie. Czasem wystarczy numer zapisany na karcie zlecenia lub etykieta na całej partii. Dokładniejsza identyfikacja ma sens dopiero wtedy, kiedy faktycznie daje korzyść.",
  },
  {
    question: "A jeśli zajmuję się szlifowaniem detali według rysunku?",
    answer:
      "To inny rodzaj procesu. Przy zapytaniach produkcyjnych ważniejsze mogą być rysunek, materiał, tolerancje, liczba sztuk i termin. Formularz oraz dalszy obieg informacji trzeba wtedy zaprojektować pod takie zlecenia, a nie pod serwis pił czy frezów.",
  },
];
---

<BaseLayout meta={meta}>
  <Banner />
  <div class="flex min-h-screen w-full flex-col">
    <Navbar />
    <main>
      <Section
        heroSection
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:gap-16"
      >
        <div class="animate-reveal flex max-w-3xl flex-col items-start gap-7">
          <p class="text-sm font-semibold text-primary">
            Dla ostrzarni i serwisów narzędzi
          </p>
          <Heading tag="h1" look="h1"
            >Strona i małe usprawnienia dla ostrzarni i szlifierni</Heading
          >
          <p
            class="max-w-2xl text-lg leading-8 text-base-content/70 md:text-xl"
          >
            Pomagam uporządkować to, co klient widzi na stronie, i wybrane
            zadania w zakładzie: od przyjęcia narzędzi po zapis ustaleń i
            kontakt po zakończeniu pracy.
          </p>
          <p class="max-w-2xl leading-7 text-base-content/70">
            Nie zaczynam od gotowego systemu. Najpierw sprawdzamy, co
            rzeczywiście zabiera czas albo powoduje niepotrzebne zamieszanie.
            Czasem wystarczy poprawić jeden krok.
          </p>
          <div class="flex flex-wrap gap-3">
            <Button link="kontakt" class="btn-primary px-7"
              >Pokaż mi 2–3 typowe zlecenia</Button
            ><Button link="#co-moge-zrobic" rawLink class="btn-outline px-7"
              >Zobacz przykłady</Button
            >
          </div>
        </div>
        <div class="hero-illustration animate-reveal-delay">
          <MyImage
            img={image}
            alt="Rysunkowa ilustracja ostrzenia narzędzi"
            size="h-full w-full"
            layout="object-contain"
            aspect="aspect-square"
            rounded="rounded-none"
            shadow=""
            class="h-full w-full p-3 md:p-5"
          />
        </div>
      </Section>

      <Section
        variant="secondary"
        containerSize="max-w-7xl"
        innerDivClasses="flex flex-col gap-9"
      >
        <div class="max-w-3xl">
          <Heading tag="h2" look="h2"
            >Nie każda ostrzarnia potrzebuje tego samego.</Heading
          ><p class="mt-4 leading-7 text-base-content/68">
            Inaczej wygląda obsługa stałej stolarni oddającej regularnie partię
            narzędzi, a inaczej klienta, który raz na jakiś czas przynosi jedną
            piłę.
          </p><p class="mt-3 leading-7 text-base-content/68">
            Dlatego rozwiązanie powinno pasować do sposobu, w jaki pracujesz
            dzisiaj — a nie zmuszać zakład do pracy pod system.
          </p>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <article class="process-card p-7 md:p-9">
            <Icon name="tabler:packages" class="size-8 text-primary" /><h3
              class="mt-6 text-h3"
            >
              Stały klient firmowy
            </h3><p class="mt-4 leading-7 text-base-content/70">
              Stolarnia albo zakład produkcyjny oddaje partię pił, frezów lub
              noży. Ważne jest, co dokładnie przyjęto, do kogo należą narzędzia,
              jaki zakres został uzgodniony i kiedy mają wrócić.
            </p><p
              class="mt-5 border-t border-base-content/12 pt-5 text-sm leading-6 text-base-content/70"
            >
              Może pomóc prosty rejestr zleceń, numer przyjęcia, oznaczenie
              partii albo wiadomość o gotowości.
            </p>
          </article>
          <article class="process-card p-7 md:p-9">
            <Icon name="tabler:tool" class="size-8 text-primary" /><h3
              class="mt-6 text-h3"
            >
              Pojedyncze i okazjonalne zlecenia
            </h3><p class="mt-4 leading-7 text-base-content/70">
              Klient chce najpierw wiedzieć, czy przyjmujesz jego narzędzie, jak
              je dostarczyć, ile standardowa usługa może kosztować i kiedy
              będzie gotowe.
            </p><p
              class="mt-5 border-t border-base-content/12 pt-5 text-sm leading-6 text-base-content/70"
            >
              Tutaj często wystarczy dobra informacja na stronie i krótka droga
              do przesłania potrzebnych danych.
            </p>
          </article>
        </div>
      </Section>

      <Section
        id="co-moge-zrobic"
        containerSize="max-w-7xl"
        innerDivClasses="flex flex-col gap-9"
      >
        <div class="max-w-3xl">
          <Heading tag="h2" look="h2"
            >Od tych trzech sytuacji zacząłbym najczęściej.</Heading
          ><p class="mt-4 leading-7 text-base-content/68">
            Nie są to trzy moduły jednego pakietu. Każdy problem można rozwiązać
            osobno.
          </p>
        </div>
        <div class="grid gap-5">
          <article
            class="service-tile service-tile--feature grid gap-7 p-7 md:p-9 lg:grid-cols-[.9fr_1.1fr] lg:gap-12"
          >
            <div>
              <Icon name="tabler:forms" class="size-8 text-primary" /><h3
                class="mt-6 text-h3"
              >
                „Ile kosztuje ostrzenie?” — ale brakuje danych
              </h3><p class="mt-4 leading-7 text-base-content/70">
                Klient dzwoni albo wysyła wiadomość, ale do odpowiedzi
                potrzebujesz jeszcze rodzaju narzędzia, wymiarów, liczby sztuk
                albo informacji o uszkodzeniu. Zaczyna się kolejne pytanie,
                wiadomość, zdjęcie i szukanie całej rozmowy później.
              </p>
            </div>
            <div
              class="border-t border-base-content/12 pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0"
            >
              <p class="text-sm font-semibold text-primary">
                Co można zrobić?
              </p><p class="mt-3 leading-7 text-base-content/70">
                Krótki formularz dopasowany do usług, które rzeczywiście
                wykonujesz. Zbiera tylko informacje potrzebne do wstępnej oceny
                i — gdy ma to sens — zdjęcie narzędzia.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Zgłoszenie może trafić w jedno miejsce, a odpowiednia osoba od
                razu dostać informację, że pojawiła się nowa sprawa.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Formularz nie musi zastępować telefonu ani e-maila. Ma pomagać
                tam, gdzie regularnie brakuje tych samych danych.
              </p>
              <div class="mt-6 border-t border-base-content/12 pt-6">
                <p class="leading-7 text-base-content/70">
                  Przygotowałem interaktywny przykład takiego zgłoszenia. Pokazuje,
                  jakie dane można zebrać przed wyceną; nie oblicza ceny ani nie
                  wysyła informacji.
                </p>
                <a
                  href="/oferta/szlifiernie/kalkulator/"
                  class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                >
                  Wypróbuj przykładowy formularz
                  <Icon name="tabler:arrow-up-right" class="size-5" />
                </a>
              </div>
            </div>
          </article>
          <article
            class="process-card grid gap-7 p-7 md:p-9 lg:grid-cols-[.9fr_1.1fr] lg:gap-12"
          >
            <div>
              <Icon name="tabler:file-check" class="size-8 text-primary" /><h3
                class="mt-6 text-h3"
              >
                Po oględzinach okazuje się, że trzeba zrobić więcej
              </h3><p class="mt-4 leading-7 text-base-content/70">
                Klient zgłasza standardowe ostrzenie, ale po przyjęciu wychodzi
                uszkodzenie wymagające dodatkowej regeneracji.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Trzeba uzgodnić nowy zakres, koszt albo termin przed
                rozpoczęciem dodatkowej pracy.
              </p>
            </div>
            <div
              class="border-t border-base-content/12 pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0"
            >
              <p class="text-sm font-semibold text-primary">
                Co można zrobić?
              </p><p class="mt-3 leading-7 text-base-content/70">
                Przy zleceniu można zapisać zdjęcie, proponowany zakres
                dodatkowej pracy i wycenę, a klientowi wysłać prostą prośbę o
                akceptację.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Odpowiedź zostaje przy zleceniu, więc później wiadomo, co
                zostało uzgodnione.
              </p><p class="mt-3 leading-7 text-base-content/70">
                O tym, czy naprawa jest potrzebna i ile powinna kosztować, nadal
                decyduje fachowiec. Narzędzie cyfrowe ma usprawnić przekazanie
                informacji i zapis decyzji.
              </p>
            </div>
          </article>
          <article
            class="process-card grid gap-7 p-7 md:p-9 lg:grid-cols-[.9fr_1.1fr] lg:gap-12"
          >
            <div>
              <Icon name="tabler:packages" class="size-8 text-primary" /><h3
                class="mt-6 text-h3"
              >
                Kilka podobnych partii czeka równocześnie w zakładzie
              </h3><p class="mt-4 leading-7 text-base-content/70">
                Przy pytaniu klienta o termin trzeba ustalić, które narzędzia
                należą do jego firmy, ile sztuk przyjęto, jaki był uzgodniony
                zakres i czy praca jest już gotowa.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Jeśli obecny sposób działa, nie ma powodu go komplikować. Jeśli
                regularnie trzeba czegoś szukać, można ten fragment uprościć.
              </p>
            </div>
            <div
              class="border-t border-base-content/12 pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0"
            >
              <p class="text-sm font-semibold text-primary">
                Co można zrobić?
              </p><p class="mt-3 leading-7 text-base-content/70">
                Prosty rejestr łączy klienta, partię, liczbę narzędzi, zakres i
                ustalony termin.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Numer przyjęcia może wystarczyć do oznaczenia skrzynki lub
                partii. Jeśli potrzebna jest dokładniejsza identyfikacja,
                później można dołożyć etykiety albo historię konkretnych
                narzędzi.
              </p><p class="mt-3 leading-7 text-base-content/70">
                Po zakończeniu pracy zmiana statusu może przygotować lub wysłać
                klientowi wiadomość o odbiorze.
              </p>
            </div>
          </article>
        </div>
      </Section>

      <Section
        variant="secondary"
        containerSize="max-w-7xl"
        innerDivClasses="flex flex-col gap-9"
      >
        <div class="max-w-3xl">
          <Heading tag="h2" look="h2"
            >A jeśli problem leży gdzie indziej?</Heading
          ><p class="mt-4 leading-7 text-base-content/68">
            Powyższe trzy sytuacje to tylko przykłady. W niektórych zakładach
            ważniejszy będzie transport, w innych dokumenty, realizacje na
            stronie albo zupełnie inna powtarzalna czynność.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {
            otherImprovements.map((item) => (
              <article class="process-card flex h-full flex-col p-6">
                <>
                  <Icon name={item.icon} class="size-7 text-primary" />
                  <h3 class="mt-6 text-xl font-semibold tracking-tight">
                    {item.title}
                  </h3>
                  <p class="mt-3 text-sm leading-6 text-base-content/70">
                    {item.text}
                  </p>
                </>
              </article>
            ))
          }
        </div>
        <div
          class="process-card grid gap-5 p-7 md:grid-cols-[1fr_auto] md:items-center md:p-9"
          style="background: color-mix(in oklch, var(--color-primary) 10%, var(--color-base-100));"
        >
          <div>
            <Icon
              name="tabler:message-question"
              class="size-7 text-primary"
            /><h3 class="mt-4 text-h3">Twój własny problem</h3><p
              class="mt-3 max-w-2xl leading-7 text-base-content/70"
            >
              Masz powtarzalną czynność, której tutaj nie wymieniłem? Opisz ją.
              Najpierw sprawdzimy, czy warto coś zmieniać, a dopiero później jak
              to zrobić.
            </p>
          </div><a
            href="/kontakt/"
            class="inline-flex min-h-11 items-center gap-2 font-semibold text-primary hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            >Opisz problem <Icon
              name="tabler:arrow-up-right"
              class="size-4"
            /></a
          >
        </div>
      </Section>

      <Section
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-10 lg:grid-cols-[.7fr_1.3fr] lg:gap-16"
      >
        <div class="max-w-lg">
          <p class="mb-4 text-sm font-semibold text-primary">
            Obecna strona
          </p><Heading tag="h2" look="h2"
            >Twoja obecna strona może zostać.</Heading
          ><p class="mt-5 leading-7 text-base-content/68">
            Nie zakładam z góry budowy nowej strony internetowej. Jeśli obecna
            strona działa, możemy poprawić tylko te elementy, które mają
            znaczenie dla klienta albo utrudniają Ci jej aktualizowanie.
          </p>
        </div>
        <ol
          class="divide-y divide-base-content/12 border-y border-base-content/12"
        >
          {
            essentials.map(([title, text], index) => (
              <li class="grid gap-4 py-7 sm:grid-cols-[5rem_1fr] sm:gap-6">
                <>
                  <span class="card-number">0{index + 1}</span>
                  <div>
                    <>
                      <h3 class="text-xl font-semibold tracking-tight">
                        {title}
                      </h3>
                      <p class="mt-2 max-w-2xl leading-7 text-base-content/68">
                        {text}
                      </p>
                    </>
                  </div>
                </>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section
        variant="secondary"
        containerSize="max-w-7xl"
        innerDivClasses="grid gap-8 lg:grid-cols-[.7fr_1.3fr] lg:gap-16"
      >
        <div class="max-w-lg">
          <Heading tag="h2" look="h2">Kiedy takie usprawnienie ma sens?</Heading
          >
        </div>
        <div class="max-w-3xl">
          <p class="leading-7 text-base-content/70">
            Wtedy, gdy konkretny problem powtarza się na tyle często, że zaczyna
            zabierać czas albo powodować pomyłki.
          </p><p class="mt-4 leading-7 text-base-content/70">
            Może to być ciągłe dopytywanie o te same parametry, szukanie
            informacji o zleceniu, ręczne przepisywanie danych, telefony z
            pytaniem o odbiór albo strona, której nikt nie ma czasu
            aktualizować.
          </p><p class="mt-4 leading-7 text-base-content/70">
            Jeżeli obecny sposób dobrze działa przy Twojej liczbie zleceń,
            zostawmy go w spokoju. Nie trzeba cyfryzować czegoś tylko dlatego,
            że technicznie da się to zrobić.
          </p>
        </div>
      </Section>

      <Section containerSize="max-w-7xl" innerDivClasses="flex flex-col gap-10">
        <div class="max-w-2xl">
          <Heading tag="h2" look="h2">Jak wygląda współpraca?</Heading>
        </div>
        <ol class="grid gap-5 lg:grid-cols-3">
          <li class="process-card numbered-step-card p-7 lg:p-8">
            <span class="card-number">01</span>
            <div class="mt-8">
              <h3 class="text-xl font-semibold tracking-tight">
                Najpierw pokażesz mi kilka prawdziwych sytuacji
              </h3><p class="mt-2 leading-7 text-base-content/68">
                Nie potrzebuję rozbudowanej dokumentacji. Wystarczą dwa lub trzy
                przykłady: jak przyszło zgłoszenie, co zapisaliście przy
                przyjęciu, gdzie pojawiło się dodatkowe pytanie albo co trzeba
                było zrobić ręcznie.
              </p>
            </div>
          </li>
          <li class="process-card numbered-step-card p-7 lg:p-8">
            <span class="card-number">02</span>
            <div class="mt-8">
              <h3 class="text-xl font-semibold tracking-tight">
                Potem wybierzemy pierwszy krok
              </h3><p class="mt-2 leading-7 text-base-content/68">
                Na tej podstawie zaproponuję zakres konkretnego usprawnienia.
                Może nim być sam formularz, prosty rejestr, powiadomienie,
                zmiana na obecnej stronie albo niewielkie narzędzie przygotowane
                pod Twój sposób pracy.
              </p>
            </div>
          </li>
          <li class="process-card numbered-step-card p-7 lg:p-8">
            <span class="card-number">03</span>
            <div class="mt-8">
              <h3 class="text-xl font-semibold tracking-tight">
                Przed wdrożeniem znasz zakres i koszt
              </h3><p class="mt-2 leading-7 text-base-content/68">
                Nie mam jednej ceny za „system dla ostrzarni”, bo formularz
                zbierający kilka informacji i obsługa partii z oznaczeniami,
                wiadomościami i historią to różne projekty. Po ustaleniu
                pierwszego etapu dostajesz jego zakres, cenę i termin.
              </p>
            </div>
          </li>
        </ol>
      </Section>

      <Compliments variant="secondary" compact />
      <Section containerSize="max-w-5xl" innerDivClasses="flex flex-col gap-8"
        ><div class="max-w-2xl">
          <Heading tag="h2" look="h2">Najczęstsze pytania.</Heading>
        </div><FAQ items={questions} /></Section
      >
      <CTA
        heading="Co dziś niepotrzebnie zabiera czas w Twoim zakładzie?"
        paragraph="Pokaż mi dwa lub trzy typowe zlecenia albo opisz jedną powtarzalną sytuację. Nie musisz wiedzieć, czy potrzebujesz formularza, automatyzacji albo systemu. To ustalimy, gdy będzie wiadomo, co naprawdę warto uprościć."
        button1={{ link: "/kontakt", text: "Pokaż mi swój proces" }}
        variant="primary"
      />
    </main>
    <Footer />
  </div>
</BaseLayout>
