---
import Container from "@components/layout/Container.astro";

export interface Props {
  id?: string;
  variant?: "default" | "secondary" | "tetriary";
  padding?: "none" | "sm" | "md" | "lg";
  containerSize?: "sm" | "md" | "lg" | "xl" | "prose" | "full";
  innerDivClasses?: string;
  innerDivAdditionalClasses?: string;
  alwaysCenterContent?: boolean;
  alwaysLeftContent?: boolean;
  headingAndParagraphClasses?: string;
  heroSection?: boolean;
  class?: string;
}

const {
  id,
  variant = "default",
  padding = "lg",
  containerSize = "md",
  innerDivClasses = "flex flex-col gap-12",
  innerDivAdditionalClasses = "",
  headingAndParagraphClasses = "[&_h2]:text-base-content [&_p]:text-base-content [&_p]:text-lg",
  alwaysCenterContent = false,
  alwaysLeftContent = false,
  heroSection = false,
  class: className,
  ...rest
} = Astro.props;

const variantClasses = {
  default: "",
  secondary: "bg-base-200",
  tetriary: "bg-neutral",
};

const paddingClasses = {
  none: "",
  sm: "py-6 md:py-8",
  md: "py-8 md:py-10 lg:py-12",
  lg: "py-12 md:py-14 lg:py-16",
};

const headingAndParagraphDefaultClases = heroSection
  ? "[&_h2]:text-base-content [&_p]:text-base-content [&_p]:text-h5 [&_p]:mt-4"
  : headingAndParagraphClasses;
---

<section
  id={id}
  class:list={[
    "w-full",
    variantClasses[variant],
    paddingClasses[padding],
    className,
  ]}
  {...rest}
>
  <Container size={containerSize}>
    <div class:list={[innerDivClasses, innerDivAdditionalClasses]}>
      {
        (Astro.slots.has("heading") || Astro.slots.has("paragraph")) && (
          <div
            class:list={[
              "flex w-full items-center",
              alwaysCenterContent
                ? "justify-center"
                : alwaysLeftContent
                  ? "justify-items-start"
                  : "lg:justify-center",
            ]}
          >
            <div
              class:list={[
                "flex flex-col gap-4 max-w-prose",
                headingAndParagraphDefaultClases,
                alwaysCenterContent
                  ? "text-center"
                  : alwaysLeftContent
                    ? "text-left"
                    : "text-left lg:text-center",
              ]}
            >
              <slot name="heading" />
              <slot name="paragraph" />
            </div>
          </div>
        )
      }
      <slot />
    </div>
  </Container>
</section>
