---
import Container from "@components/layout/Container.astro";

export interface Props {
  id?: string;
  variant?: "default" | "secondary" | "tetriary" | "tinted" | "dark";
  padding?: "none" | "sm" | "md" | "lg";
  containerSize?: string;
  innerDivClasses?: string;
  innerDivAdditionalClasses?: string;
  alwaysCenterContent?: boolean;
  alwaysLeftContent?: boolean;
  headingAndParagraphClasses?: string;
  heroSection?: boolean;
  preLabel?: string;
  class?: string;
  style?: string;
}

const {
  id,
  variant = "default",
  padding = "lg",
  containerSize = "max-w-3xl",
  innerDivClasses = "flex flex-col gap-8 lg:gap-12",
  innerDivAdditionalClasses = "",
  headingAndParagraphClasses = "[&_h2]:text-base-content [&_p]:text-base-content [&_p]:text-lg",
  alwaysCenterContent = false,
  alwaysLeftContent = false,
  heroSection = false,
  preLabel,
  class: className,
  ...rest
} = Astro.props;

const variantClasses = {
  default: "",
  secondary: "bg-base-200",
  tetriary: "bg-neutral",
  tinted: "bg-primary/4",
  dark: "bg-neutral text-neutral-content [&_p]:text-neutral-content/80 [&_h2]:text-neutral-content [&_h3]:text-neutral-content",
};

const paddingClasses = {
  none: "",
  sm: "py-6 md:py-8",
  md: "py-8 md:py-10 lg:py-12",
  lg: "py-16 md:py-20 lg:py-24",
};

const headingAndParagraphDefaultClases = heroSection
  ? "[&_h2]:text-base-content [&_p]:text-base-content [&_p]:text-h5 [&_p]:leading-8 [&_p]:mt-4"
  : headingAndParagraphClasses;
---

<section
  id={id}
  class:list={[
    "w-full",
    variantClasses[variant],
    heroSection
      ? "relative pt-24 md:pt-36 lg:pt-44 pb-16 md:pb-24 lg:pb-28"
      : paddingClasses[padding],
    className,
  ]}
  {...rest}
>
  <Container size={containerSize}>
    <div class:list={[innerDivClasses, innerDivAdditionalClasses]}>
      {
        (Astro.slots.has("heading") || Astro.slots.has("paragraph")) && (
          <div
            class:list={[
              "flex w-full items-center",
              alwaysCenterContent
                ? "justify-center"
                : alwaysLeftContent
                  ? "justify-items-start"
                  : "lg:justify-center",
            ]}
          >
            <div
              class:list={[
                "flex flex-col gap-4 max-w-prose",
                headingAndParagraphDefaultClases,
                alwaysCenterContent
                  ? "text-center"
                  : alwaysLeftContent
                    ? "text-left"
                    : "text-left lg:text-center",
              ]}
            >
              {preLabel && (
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-base-content/40 font-medium -mb-2">
                  {preLabel}
                </p>
              )}
              <slot name="heading" />
              <slot name="paragraph" />
            </div>
          </div>
        )
      }
      <slot />
    </div>
  </Container>
</section>
