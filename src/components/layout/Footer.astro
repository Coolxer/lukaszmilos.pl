---
import { Icon } from "astro-icon/components";
import { buildSlug } from "~/utils/utils";
import config from "~/data/consts.json";
import Container from "@components/layout/Container.astro";
import { industries } from "@data/industries";

const currentYear = new Date().getFullYear();
const serviceLinks = [
  { text: "Oferta", slug: "oferta" },
  { text: "Strony internetowe", slug: "oferta/strony-www" },
  { text: "Systemy i automatyzacje", slug: "oferta/systemy-i-automatyzacje" },
  { text: "Realizacje", slug: "portfolio" },
  { text: "Blog", slug: "blog" },
  { text: "O mnie", slug: "o-mnie" },
  { text: "Kontakt", slug: "kontakt" },
];
---

<footer class="border-t border-white/10 bg-[#101c2e] text-[#edf5ff]">
  <Container size="max-w-7xl">
    <div class="py-12 md:py-16">
      <div class="grid gap-10 md:grid-cols-2 xl:grid-cols-[1.2fr_.9fr_.9fr_.85fr_.9fr] xl:gap-10">
        <div class="max-w-md">
          <a href="/" class="inline-flex min-h-11 items-center text-2xl font-semibold tracking-tight text-[#76adff]">Łukasz Miłoś</a>
          <p class="mt-4 leading-7 text-white/70">Tworzę strony internetowe i praktyczne narzędzia cyfrowe dla firm, które chcą działać czytelniej i sprawniej.</p>
        </div>
        <div>
          <p class="font-semibold text-white">Usługi</p>
          <nav class="mt-2 flex flex-col" aria-label="Nawigacja w stopce">
            {serviceLinks.map((link) => <a href={buildSlug(link.slug)} class="flex min-h-11 items-center text-sm font-medium text-white/70 transition-colors hover:text-white">{link.text}</a>)}
          </nav>
        </div>
        <div>
          <p class="font-semibold text-white">Branże</p>
          <nav class="mt-2 flex flex-col" aria-label="Branże w stopce">
            {industries.map((industry) => <a href={industry.link} class="flex min-h-11 items-center text-sm leading-5 text-white/70 transition-colors hover:text-white">{industry.title}</a>)}
          </nav>
        </div>
        <div><p class="font-semibold text-white">Dane firmowe</p><div class="mt-3 flex flex-col gap-1 text-sm leading-6 text-white/65"><p class="font-medium text-white">{config.company.name}</p><p>{config.company.address}</p><p>NIP: {config.company.nip}</p><p>REGON: {config.company.regon}</p></div></div>
        <div><p class="font-semibold text-white">Kontakt</p><div class="mt-3 flex flex-col gap-3 text-sm text-white/70">{config.company.email.map((email) => <a href={`mailto:${email}`} class="inline-flex min-h-11 items-center transition-colors hover:text-white">{email}</a>)}<div class="flex gap-2">{config.socials.map((social) => <a href={social.href} aria-label={social.label} class="social-link social-link--footer" target="_blank" rel="noopener noreferrer"><Icon name={social.icon} class="size-5" /></a>)}</div></div></div>
      </div>
      <div class="my-8 h-px bg-white/12"></div>
      <div class="flex flex-col items-center justify-between gap-4 text-sm md:flex-row"><p class="text-white/55">© {currentYear} Łukasz Miłoś. Wszystkie prawa zastrzeżone.</p><a href={buildSlug("polityka-prywatnosci")} class="inline-flex min-h-11 items-center text-white/55 transition-colors hover:text-white">Polityka prywatności</a></div>
    </div>
  </Container>
</footer>
