---
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";

interface ButtonProps {
  text: string;
  link: string;
  class?: string;
  rawLink?: boolean;
}

interface Props {
  id?: string;
  heading: string;
  paragraph?: string;
  description?: string;
  button1?: ButtonProps;
  button2?: ButtonProps;
  variant?: "primary" | "subtle";
  class?: string;
}

const {
  id,
  heading,
  paragraph,
  description,
  button1,
  button2,
  variant = "primary",
  class: additionalClasses,
} = Astro.props;

const variantStyles = {
  primary: {
    inner: "cta-panel bg-primary text-primary-content shadow-[0_1.25rem_3.5rem_color-mix(in_oklch,var(--color-primary)_22%,transparent)]",
    text: "[&_p]:text-primary-content/84 [&_p]:text-lg",
  },
  subtle: {
    inner: "bg-base-200 text-base-content",
    text: "[&_p]:text-base-content/80 [&_p]:text-lg",
  },
};

const styles = variantStyles[variant];

const innerDivAdditionalClasses =
  "rounded-[20px] p-8 md:p-12 text-left " + styles.inner + additionalClasses;
---

<Section
  id={id}
  containerSize="max-w-7xl"
  alwaysLeftContent
  innerDivAdditionalClasses={innerDivAdditionalClasses}
  headingAndParagraphClasses={styles.text}
>
  <Heading tag="h2" slot="heading">{heading}</Heading>

  {paragraph && <p slot="paragraph">{paragraph}</p>}

  {description && <p class="mt-4">{description}</p>}

  {
    (button1 || button2) && (
      <div class="flex flex-wrap items-center gap-4">
        {button1 && (
          <Button
            link={button1.link}
            class={variant === "primary" ? "cta-primary-action btn border-0" : "btn-primary"}
            rawLink={button1.rawLink}
          >
            {button1.text}
          </Button>
        )}
        {button2 && (
          <Button
            link={button2.link}
            class={variant === "primary" ? "cta-secondary-action btn border-2" : "btn-outline"}
            rawLink={button2.rawLink}
          >
            {button2.text}
          </Button>
        )}
      </div>
    )
  }
</Section>
