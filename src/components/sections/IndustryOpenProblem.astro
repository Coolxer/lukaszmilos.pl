---
import Section from "@components/layout/Section.astro";
import Heading from "@components/ui/Heading.astro";
import Button from "@components/ui/Button.astro";

export interface Props {
  heading?: string;
  paragraph?: string;
}

const {
  heading = "Nie widzisz tu swojego problemu?",
  paragraph = "Nie musisz wybierać rozwiązania z listy. Jeśli jakiś fragment codziennej pracy zabiera czas, powoduje pomyłki albo po prostu przeszkadza, opisz go własnymi słowami. Sprawdzimy, czy warto go uprościć i od czego zacząć.",
} = Astro.props;
---

<Section containerSize="max-w-7xl">
  <div class="industry-open-panel">
    <div>
      <Heading tag="h2" look="h2" class="max-w-xl">{heading}</Heading>
    </div>
    <div class="max-w-2xl">
      <p class="text-lg leading-8 text-base-content/70">{paragraph}</p>
      <div class="mt-8">
        <Button link="kontakt" class="btn-primary px-7">Opisz sytuację</Button>
      </div>
    </div>
  </div>
</Section>
