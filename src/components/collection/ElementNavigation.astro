---
import { Icon } from "astro-icon/components";
import type { CollectionEntry, CollectionKey } from "astro:content";
import { slugify } from "@utils/utils";
import Button from "@components/ui/Button.astro";

export interface Props<C extends CollectionKey = CollectionKey> {
  collection: C;
  baseSlug: string;
  prevElement: CollectionEntry<C> | null;
  prevText?: string;
  nextElement: CollectionEntry<C> | null;
  nextText?: string;
  archiveLink?: string;
  archiveText?: string;
  class?: string;
}

const { collection, baseSlug, prevElement, prevText = "Poprzedni", nextElement, nextText = "Następny", archiveLink, archiveText, class: className } = Astro.props;
const prevHref = prevElement?.id ? baseSlug + slugify(prevElement.id) : undefined;
const nextHref = nextElement?.id ? baseSlug + slugify(nextElement.id) : undefined;
---

<nav class:list={["detail-navigation", className]} aria-label={`Nawigacja: ${collection}`}>
  {
    prevHref && (
      <a href={prevHref} class="detail-navigation-link btn btn-outline">
        <Icon name="tabler:arrow-left" class="size-4" />
        <span>{prevText}</span>
      </a>
    )
  }
  {archiveLink && archiveText && <Button link={archiveLink} class="btn-primary detail-navigation-archive">{archiveText}</Button>}
  {
    nextHref && (
      <a href={nextHref} class="detail-navigation-link detail-navigation-link--next btn btn-outline">
        <span>{nextText}</span>
        <Icon name="tabler:arrow-right" class="size-4" />
      </a>
    )
  }
</nav>
