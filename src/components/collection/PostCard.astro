---
import type { CollectionEntry } from "astro:content";
import { buildSlug } from "@utils/utils";
import Heading, { type Tag } from "@components/ui/Heading.astro";

export interface Props {
  post: CollectionEntry<"blog">;
  headingTag?: Tag;
  class?: string;
}

const { post, headingTag = "h3", class: className } = Astro.props;

const link = buildSlug(`/blog/${post.id}/`);
---

<article class:list={["border-t border-base-content/10 py-6", className]}>
  <a href={link} class="group flex flex-col gap-2">
    {
      post.data.categories && post.data.categories.length > 0 && (
        <div class="flex flex-wrap gap-3">
          {post.data.categories.map((cat) => (
            <span class="font-mono text-xs uppercase tracking-[0.15em] text-base-content/40">
              {cat}
            </span>
          ))}
        </div>
      )
    }
    <Heading tag={headingTag} look="h4" class="group-hover:text-primary transition-colors">
      {post.data.heading}
    </Heading>
    {
      post.data.subheading && (
        <p class="text-base-content/60 font-light leading-relaxed line-clamp-2">
          {post.data.subheading}
        </p>
      )
    }
  </a>
</article>
