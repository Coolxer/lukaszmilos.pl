---
import { buildSlug } from "~/utils/utils";

export type NavLink = {
  slug?: string;
  href?: string;
  label: string;
};

export interface Props {
  items?: NavLink[];
  additionalItems?: NavLink[];
  class?: string;
}

const {
  items = [
    { slug: "oferta", label: "Usługi" },
    { slug: "portfolio", label: "Realizacje" },
    { slug: "o-mnie", label: "O mnie" },
  ],
  additionalItems = [],
  class: className,
} = Astro.props;

const links = [...items, ...additionalItems];
---

{links.map((link) => <a href={link.href || buildSlug(link.slug || "")} class={className}>{link.label}</a>)}
