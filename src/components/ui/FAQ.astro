---
import { marked } from "marked";
import { Icon } from "astro-icon/components";

export type FaqItem = { question: string; answer: string };
export interface Props { name?: string; items: FaqItem[]; }

const { items } = Astro.props;
const processedItems = items.map((item) => ({ ...item, htmlAnswer: item.answer.trim().startsWith("<") ? item.answer : marked.parse(item.answer) }));
---

<div class="faq-list">
  {processedItems.map((item) => (
    <details class="faq-item">
      <summary><span class="text-h5">{item.question}</span><Icon name="tabler:plus" class="faq-item-icon size-5 shrink-0" /></summary>
      <div class="faq-item-answer prose max-w-none text-base-content/68" set:html={item.htmlAnswer} />
    </details>
  ))}
</div>
